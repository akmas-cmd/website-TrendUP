}
.contact-info-card h3{font-size:20px;color:var(--white);}
.contact-info-card > p{color:#bbb;font-size:14px;margin-top:8px;margin-bottom:28px;}
.contact-info-list{list-style:none;margin:0;padding:0;}
.contact-info-list li{
