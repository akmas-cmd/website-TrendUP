  padding:16px 18px;border-bottom:2px solid var(--jet);background:var(--soft-gray);
  cursor:pointer;user-select:none;white-space:nowrap;
}
.table-trendup thead th.sortable:hover{color:var(--jet);}
.table-trendup thead th .sort-icon{margin-left:6px;font-size:10px;opacity:.4;}
.table-trendup thead th.sort-active .sort-icon{opacity:1;color:var(--jet);}
.table-trendup tbody td{padding:14px 18px;border-bottom:1px solid var(--soft-gray);font-size:13px;vertical-align:middle;}
.table-trendup tbody tr:hover{background:#fafafa;}

.customer-avatar{
  width:36px;height:36px;border-radius:50%;background:var(--jet);color:var(--lime);
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;
}
.customer-name{font-weight:700;}
.customer-email{font-size:12px;color:var(--cool-gray);}

.status-pill{padding:5px 12px;border-radius:999px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.3px;}
