.main-content{flex:1;min-width:0;}
.topbar{background:var(--white);border-bottom:2px solid var(--jet);padding:18px 34px;display:flex;align-items:center;justify-content:space-between;gap:20px;position:sticky;top:0;z-index:100;flex-wrap:wrap;}
