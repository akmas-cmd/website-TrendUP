.topbar h1{font-size:22px;margin:0;}
.content-pad{padding:30px 34px 50px;}

.btn-primary-trendup{
  background:var(--jet);color:var(--white);border:none;border-radius:999px;
  padding:12px 24px;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.5px;
  display:inline-flex;align-items:center;gap:8px;
  transition:background .15s ease, color .15s ease;
}
