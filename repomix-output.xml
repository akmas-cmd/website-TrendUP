.custom-select-wrap.select-wrap-form .custom-select-toggle{
  border:2px solid var(--jet);
  border-radius:10px;
  padding:11px 14px;
}
.custom-select-wrap.select-wrap-form{
  width:100%;
  min-width:0;
}

