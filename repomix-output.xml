<file path="public/css/register.css">
:root{
  --jet:#111111;
  --white:#FFFFFF;
  --soft-gray:#F5F5F5;
  --cool-gray:#8A8A8A;
  --lime:#C6FF00;
}
*{box-sizing:border-box;}
body{
  font-family:'Work Sans', sans-serif;
  background:var(--white);
  color:var(--jet);
  margin:0;
}
h1,h2,h3,.display-font{
  font-family:'Anton', sans-serif;
  text-transform:uppercase;
  letter-spacing:0.5px;
  line-height:0.95;
}
a{text-decoration:none;}

.auth-wrapper{
  min-height:100vh;
  display:flex;
}

/* ===== LEFT BRAND PANEL ===== */
.brand-panel{
  flex:1;
  background:var(--jet);
  color:var(--white);
  padding:60px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
}
.brand-panel::before{
  content:"";
  position:absolute;
  top:50%; left:50%;
  width:420px;height:420px;
  background:var(--lime);
  opacity:.3;
  border-radius:50%;
  filter:blur(70px);
  transform:translate(-50%,-50%);
}
.brand-logo{
  font-family:'Anton', sans-serif;
  font-size:30px;
  letter-spacing:1px;
  color:var(--white);
  position:relative;
  z-index:1;
}
.brand-logo::after{
  content:"";
  display:block;
  width:60px;
  height:5px;
  background:var(--lime);
  margin-top:6px;
  transform:skewX(-20deg);
}
.brand-tagline{
  align-self:flex-start;
  position:relative;
  z-index:1;
  color:var(--cool-gray);
  font-size:14px;
  font-weight:600;
  margin-top:16px;
}
.brand-image-wrap{
  position:relative;
  z-index:1;
  margin-top:auto;
  margin-bottom:auto;
  display:flex;
  align-items:center;
  justify-content:center;
}
.brand-image{
  max-width:95%;
  max-height:65vh;
  object-fit:contain;
  filter:drop-shadow(0 20px 40px rgba(0,0,0,.5));
}
.brand-caption{
  align-self:center;
  position:relative;
  z-index:1;
  color:var(--cool-gray);
  font-size:13px;
  text-align:center;
  max-width:280px;
  margin:0 auto;
}

.brand-quote{position:relative;z-index:1;}
.brand-quote .tag{
  color:var(--lime);
  font-weight:700;
  font-size:13px;
  letter-spacing:3px;
  text-transform:uppercase;
  margin-bottom:16px;
  display:inline-block;
}
.brand-quote h2{font-size:44px;margin-bottom:16px;}
.brand-quote p{color:var(--cool-gray);font-size:15px;max-width:380px;line-height:1.6;}

.perk-list{position:relative;z-index:1;display:flex;flex-direction:column;gap:16px;}
.perk-item{display:flex;align-items:center;gap:14px;font-size:14px;color:#ddd;}
.perk-item i{
  width:34px;height:34px;
  background:rgba(198,255,0,.15);
  color:var(--lime);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}

/* ===== RIGHT FORM PANEL ===== */
.form-panel{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px;
  overflow-y:auto;
}
.form-box{width:100%;max-width:420px;padding:30px 0;}
.form-box .eyebrow{
