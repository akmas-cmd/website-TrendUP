  padding:9px 12px;
  font-size:13px;
  font-weight:600;
  color:var(--jet);
  border-radius:8px;
  cursor:pointer;
  white-space:nowrap;
  transition:background .12s ease;
}
.custom-select-menu li:hover{
  background:var(--soft-gray);
}
.custom-select-menu li.active{
  background:var(--lime);
  color:var(--jet);
