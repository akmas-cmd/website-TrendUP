  font-weight:700;
  font-size:13px;
  letter-spacing:3px;
  text-transform:uppercase;
}
.form-box h1{font-size:36px;margin:8px 0 8px;}
.form-box .sub{color:var(--cool-gray);font-size:14px;margin-bottom:28px;}
.form-box .sub a{color:var(--jet);font-weight:700;text-decoration:underline;}

.form-label-trendup{
  font-weight:700;
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:.5px;
  margin-bottom:8px;
  display:block;
}
.input-wrap{position:relative;margin-bottom:18px;}
.input-wrap i.leading-icon{
  position:absolute;
  left:16px; top:50%;
  transform:translateY(-50%);
  color:var(--cool-gray);
  font-size:14px;
}
.form-control-trendup{
  width:100%;
  border:2px solid var(--jet);
  border-radius:12px;
  padding:14px 16px 14px 44px;
  font-size:14px;
  outline:none;
  transition:border-color .15s ease, box-shadow .15s ease;
}
.form-control-trendup:focus{box-shadow:0 0 0 3px rgba(198,255,0,.35);}
.form-control-trendup.error{border-color:#d33;}
.toggle-pass{
  position:absolute;
  right:16px; top:50%;
  transform:translateY(-50%);
  background:none;border:none;color:var(--cool-gray);cursor:pointer;
}
.error-msg{
  color:#d33;font-size:12px;font-weight:600;
  margin-top:-12px;margin-bottom:16px;display:none;
}
.error-msg.show{display:block;}

.row-2col{display:grid;grid-template-columns:1fr 1fr;gap:14px;}

/* ===== PASSWORD STRENGTH ===== */
.strength-bar{
  display:flex;
  gap:6px;
  margin:-10px 0 6px;
}
.strength-bar .seg{
  flex:1;height:5px;border-radius:4px;background:var(--soft-gray);
}
.strength-bar .seg.active-weak{background:#d33;}
.strength-bar .seg.active-mid{background:#f0a500;}
.strength-bar .seg.active-strong{background:#1a7a1a;}
.strength-label{font-size:11px;color:var(--cool-gray);font-weight:600;margin-bottom:16px;display:block;}

.form-check-trendup{
  display:flex;
  align-items:flex-start;
  gap:10px;
  font-size:13px;
  color:#444;
  margin-bottom:26px;
}
.form-check-trendup input{
  width:18px;height:18px;
  accent-color:var(--jet);
  margin-top:2px;
  flex-shrink:0;
}
.link-lime{color:var(--jet);font-weight:700;text-decoration:underline;}

.btn-submit{
  width:100%;
  background:var(--jet);
  color:var(--white);
  border:none;
  border-radius:999px;
  padding:16px;
  font-weight:800;
  font-size:14px;
  text-transform:uppercase;
  letter-spacing:1px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  transition:transform .2s ease, background .15s ease, color .15s ease;
}
.btn-submit:hover{transform:translateY(-2px);background:var(--lime);color:var(--jet);}
.btn-submit:disabled{opacity:.6;transform:none;}

.divider-or{
  display:flex;align-items:center;gap:14px;
  margin:24px 0;color:var(--cool-gray);
  font-size:12px;text-transform:uppercase;font-weight:700;
}
.divider-or::before, .divider-or::after{content:"";flex:1;height:1px;background:var(--soft-gray);}

.social-login{display:flex;gap:12px;}
.btn-social{
  flex:1;border:2px solid var(--soft-gray);background:var(--white);
  border-radius:12px;padding:12px;
  display:flex;align-items:center;justify-content:center;gap:10px;
  font-weight:700;font-size:13px;color:var(--jet);
}
.btn-social:hover{border-color:var(--jet);}

.alert-trendup{
  background:#eafbea;color:#1a7a1a;border-radius:10px;
  padding:12px 16px;font-size:13px;font-weight:600;
  margin-bottom:20px;display:none;align-items:center;gap:8px;
}
.alert-trendup.show{display:flex;}

@media (max-width: 900px){
  .brand-panel{display:none;}
  .form-panel{padding:24px;}
  .row-2col{grid-template-columns:1fr;}
}

.lang-switch-btn{
  background:var(--jet);
  color:var(--white)!important;
  border:none;
  padding:9px 16px;
  border-radius:999px;
  font-weight:700;
  font-size:13px;
  text-transform:uppercase;
  display:inline-flex;
  align-items:center;
  gap:6px;
}
.lang-switch-btn:hover,
.lang-switch-btn:focus{
  background:var(--jet);
  color:var(--white)!important;
}
.lang-switch-btn::after{
  border-top-color:var(--white);
}

/* ===== LANGUAGE SWITCHER DROPDOWN (custom, matches site design language) ===== */
.lang-switch-dropdown{
  position:relative;
  user-select:none;
}
.lang-switch-dropdown .lang-switch-btn i{
  font-size:10px;
  transition:transform .2s ease;
}
.lang-switch-dropdown.open .lang-switch-btn i{
  transform:rotate(180deg);
}
.lang-switch-menu{
  list-style:none;
