.custom-select-wrap.open .custom-select-menu{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
}
.custom-select-menu li{
  padding:9px 12px;
  font-size:13px;
  font-weight:600;
  color:var(--jet);
  border-radius:8px;
  cursor:pointer;
  white-space:nowrap;
  transition:background .12s ease;
