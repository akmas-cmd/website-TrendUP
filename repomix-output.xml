}
.stock-pill{font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px;}
.stock-ok{background:#eafbea;color:#1a7a1a;}
.stock-low{background:#fff4e5;color:#b45309;}
.stock-empty{background:#fde8e8;color:#c81e1e;}
.badge-mini{font-size:10px;font-weight:800;padding:3px 9px;border-radius:999px;text-transform:uppercase;}
.badge-new-mini{background:var(--jet);color:var(--white);}
.badge-sale-mini{background:var(--lime);color:var(--jet);}
.badge-none-mini{background:var(--soft-gray);color:var(--cool-gray);}
.action-btn{
  width:32px;height:32px;border-radius:8px;border:1px solid var(--soft-gray);background:var(--white);
  display:inline-flex;align-items:center;justify-content:center;color:var(--jet);margin-right:4px;
}
.action-btn:hover{background:var(--jet);color:var(--white);}
.action-btn.danger:hover{background:#c81e1e;border-color:#c81e1e;}

.pagination-bar{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;font-size:12px;color:var(--cool-gray);flex-wrap:wrap;gap:12px;}
.pagination-controls{display:flex;align-items:center;gap:6px;}
.page-btn{
  min-width:34px;height:34px;border:2px solid var(--soft-gray);background:var(--white);border-radius:8px;
  font-weight:700;font-size:12px;color:var(--jet);display:flex;align-items:center;justify-content:center;padding:0 8px;
}
.page-btn:hover{border-color:var(--jet);}
.page-btn.active{background:var(--jet);border-color:var(--jet);color:var(--white);}
.page-btn:disabled{opacity:.4;cursor:not-allowed;}

/* ===== MODAL FORM ===== */
.modal-content{border-radius:20px;border:2px solid var(--jet);}
.modal-header{border-bottom:2px solid var(--jet);}
.modal-title{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:20px;}
.form-label-trendup{font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;display:block;}
.form-control-trendup, select.form-control-trendup, textarea.form-control-trendup{
  width:100%;border:2px solid var(--jet);border-radius:10px;padding:10px 14px;font-size:13px;outline:none;font-family:inherit;
}
.upload-box{
  border:2px dashed var(--cool-gray);border-radius:14px;padding:24px;text-align:center;color:var(--cool-gray);font-size:13px;cursor:pointer;
}
.upload-box:hover{border-color:var(--jet);color:var(--jet);}
.btn-modal-save{
  background:var(--lime);color:var(--jet);border:none;border-radius:999px;padding:12px 26px;font-weight:800;font-size:13px;text-transform:uppercase;
