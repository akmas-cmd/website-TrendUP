}
.form-control-trendup:focus{box-shadow:0 0 0 3px rgba(198,255,0,.35);}
textarea.form-control-trendup{resize:vertical;min-height:130px;}
.error-msg-trendup{color:#d33;font-size:12px;font-weight:600;margin-top:6px;}
.alert-success-trendup{
