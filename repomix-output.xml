  padding:26px;margin-bottom:26px;
}
.generate-head h3{font-size:18px;margin-bottom:4px;}
.generate-head p{font-size:13px;color:var(--cool-gray);margin-bottom:20px;}
.generate-form{display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end;}
.generate-form .field{flex:1;min-width:180px;}
.form-label-trendup{font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;display:block;}
