            // yang juga ada di data beranda), datanya TIDAK ditimpa/di-reset.
            Product::firstOrCreate(
                [
                    'name' => $p['name'],
                    'category_id' => $catIds[$p['cat']],
                ],
                [
                    'price' => $p['price'],
                    'badge' => $p['badge'],
                    'icon' => $p['icon'],
                    'image' => $p['image'],
                    'is_bestseller' => $p['is_bestseller'],
                ]
            );
        }
    }
