  transition:background .15s ease;
}
.chart-bar:hover{background:var(--lime);}
.chart-bar-label{font-size:11px;color:var(--cool-gray);font-weight:700;}

@media (max-width: 991px){
  .sidebar{position:fixed;left:-260px;z-index:2000;transition:left .2s ease;}
  .sidebar.open{left:0;}
  .topbar-search{display:none;}
}
