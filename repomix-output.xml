/* ===== SIMPLE BAR CHART ===== */
.chart-bars{
  display:flex;
  align-items:flex-end;
  gap:14px;
  height:180px;
  padding-top:10px;
}
.chart-bar-col{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8px;
  height:100%;
  justify-content:flex-end;
}
.chart-bar{
  width:100%;
  max-width:34px;
  background:var(--jet);
  border-radius:8px 8px 0 0;
