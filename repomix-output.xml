  display:inline-flex;align-items:center;justify-content:center;color:var(--jet);
}
.action-btn:hover{background:var(--jet);color:var(--white);}

.pagination-bar{
  display:flex;align-items:center;justify-content:space-between;padding:16px 20px;
  font-size:12px;color:var(--cool-gray);flex-wrap:wrap;gap:12px;
}
.pagination-controls{display:flex;align-items:center;gap:6px;}
.page-btn{
  min-width:34px;height:34px;border:2px solid var(--soft-gray);background:var(--white);border-radius:8px;
  font-weight:700;font-size:12px;color:var(--jet);display:flex;align-items:center;justify-content:center;padding:0 8px;
}
.page-btn:hover{border-color:var(--jet);}
.page-btn.active{background:var(--jet);border-color:var(--jet);color:var(--white);}
.page-btn:disabled{opacity:.4;cursor:not-allowed;}
.page-size-select{
  border:2px solid var(--soft-gray);border-radius:8px;padding:6px 10px;font-size:12px;font-weight:600;outline:none;
}

@media (max-width: 991px){
  .sidebar{position:fixed;left:-260px;z-index:2000;transition:left .2s ease;}
  .sidebar.open{left:0;}
}
/* ===== ULASAN (rating & review) khusus ===== */
.review-stars-admin{color:var(--lime);font-size:13px;white-space:nowrap;}
.review-stars-admin i{-webkit-text-stroke:0.5px var(--jet);}
.review-comment-admin{
