  list-style:none;
  margin:0;
  padding:6px;
  position:absolute;
  top:calc(100% + 6px);
  left:0;
  min-width:100%;
  background:var(--white);
  border:2px solid var(--jet);
  border-radius:12px;
  box-shadow:4px 4px 0px var(--jet);
  opacity:0;
  visibility:hidden;
  transform:translateY(-6px);
  transition:opacity .15s ease, transform .15s ease, visibility .15s;
  z-index:300;
  max-height:240px;
  overflow-y:auto;
