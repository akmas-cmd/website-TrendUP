}
.brand-logo::after{
  content:"";
  position:absolute;
  bottom:-2px;
  left:0;
  width:60%;
  height:5px;
  background:var(--lime);
  transform:skewX(-20deg);
}
.nav-links a{
  color:var(--jet);
  font-weight:600;
  font-size:14px;
  text-transform:uppercase;
